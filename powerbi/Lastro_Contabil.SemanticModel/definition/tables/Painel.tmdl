table Painel
	lineageTag: 69251093-1d53-5cfd-b9e0-d3faf121b605

	measure 'HTML Cabeçalho Carteira' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR quem = IF(HASONEVALUE(dCliente[CLIENTE]), SELECTEDVALUE(dCliente[CLIENTE]), FORMAT(DISTINCTCOUNT(fIndicador[CODIGO_CLIENTE]), "0") & " clientes")
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;height:70px;box-sizing:border-box;padding:11px 20px 0;background:linear-gradient(90deg,#123A3B,#061A1C 70%);border-bottom:1px solid #1B4A49'><div style='display:flex;align-items:center;gap:9px;font-size:12.5px;font-weight:600;color:#34E0BE'><span style='width:13px;height:13px;border-radius:3px 3px 6px 6px;background:linear-gradient(160deg,#7FF0DC,#34E0BE)'></span>Lastro Contábil</div><div style='font-size:23px;font-weight:800;letter-spacing:-.4px;line-height:1.2'>Carteira de clientes<span style='font-size:13px;font-weight:400;color:#A9C6C2;margin-left:12px'>" & quem & ", balancete de " & FORMAT(m, "mm/yyyy") & "</span></div></div>"
		lineageTag: 4624bfe9-5ef0-51b1-8aff-42615d7d3b89

	measure 'HTML Cabeçalho Cliente' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR quem = IF(HASONEVALUE(dCliente[CLIENTE]), SELECTEDVALUE(dCliente[CLIENTE]), FORMAT(DISTINCTCOUNT(fIndicador[CODIGO_CLIENTE]), "0") & " clientes")
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;height:70px;box-sizing:border-box;padding:11px 20px 0;background:linear-gradient(90deg,#123A3B,#061A1C 70%);border-bottom:1px solid #1B4A49'><div style='display:flex;align-items:center;gap:9px;font-size:12.5px;font-weight:600;color:#34E0BE'><span style='width:13px;height:13px;border-radius:3px 3px 6px 6px;background:linear-gradient(160deg,#7FF0DC,#34E0BE)'></span>Lastro Contábil</div><div style='font-size:23px;font-weight:800;letter-spacing:-.4px;line-height:1.2'>Painel do cliente<span style='font-size:13px;font-weight:400;color:#A9C6C2;margin-left:12px'>" & quem & ", balancete de " & FORMAT(m, "mm/yyyy") & "</span></div></div>"
		lineageTag: 080565d4-bcd1-5cb2-8b3b-0b8aecca9fca

	measure 'HTML Cabeçalho Resultado' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR quem = IF(HASONEVALUE(dCliente[CLIENTE]), SELECTEDVALUE(dCliente[CLIENTE]), FORMAT(DISTINCTCOUNT(fIndicador[CODIGO_CLIENTE]), "0") & " clientes")
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;height:70px;box-sizing:border-box;padding:11px 20px 0;background:linear-gradient(90deg,#123A3B,#061A1C 70%);border-bottom:1px solid #1B4A49'><div style='display:flex;align-items:center;gap:9px;font-size:12.5px;font-weight:600;color:#34E0BE'><span style='width:13px;height:13px;border-radius:3px 3px 6px 6px;background:linear-gradient(160deg,#7FF0DC,#34E0BE)'></span>Lastro Contábil</div><div style='font-size:23px;font-weight:800;letter-spacing:-.4px;line-height:1.2'>Resultado e caixa<span style='font-size:13px;font-weight:400;color:#A9C6C2;margin-left:12px'>" & quem & ", balancete de " & FORMAT(m, "mm/yyyy") & "</span></div></div>"
		lineageTag: cc659b93-3a41-5989-bd35-9dad37c700cc

	measure 'HTML Cartões Carteira' =
			VAR nc = CALCULATE(COUNTROWS(fCarteira), fCarteira[SITUACAO] = "Crítico") + 0
			VAR na = CALCULATE(COUNTROWS(fCarteira), fCarteira[SITUACAO] = "Atenção") + 0
			VAR nd = CALCULATE(COUNTROWS(fCarteira), fCarteira[SITUACAO] = "Em dia") + 0
			VAR atr = CALCULATE(COUNTROWS(dCliente), dCliente[MESES_ATRASO] > 0) + 0
			VAR fat = SUM(fCarteira[RECEITA_BRUTA_12M])
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;display:flex;gap:12px'>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & IF(nc > 0, "#FF6B5E", "#34E0BE") & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Precisam de conversa agora</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & IF(nc > 0, "#FF6B5E", "#F4FBFA") & "'>" & FORMAT(nc, "0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "clientes com alerta crítico" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & "#34E0BE" & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Para acompanhar</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & "#F4FBFA" & "'>" & FORMAT(na, "0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "clientes com ponto de atenção" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & "#34E0BE" & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Em dia</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & "#F4FBFA" & "'>" & FORMAT(nd, "0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "sem alerta neste balancete" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & IF(atr > 0, "#FF6B5E", "#34E0BE") & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Balancetes atrasados</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & IF(atr > 0, "#FF6B5E", "#F4FBFA") & "'>" & FORMAT(atr, "0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "painel desses clientes está desatualizado" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & "#34E0BE" & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Faturamento da carteira</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & "#F4FBFA" & "'>" & "R$ " & FORMAT(fat, "#,##0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "somado, últimos 12 meses" & "</div></div>"
			    & "</div>"
		lineageTag: 1f44c2cc-5899-5489-a67f-ee5624044017

	measure 'HTML Tabela Carteira' =
			VAR t = ADDCOLUMNS(fCarteira, "@nome", RELATED(dCliente[CLIENTE]), "@ativ", RELATED(dCliente[ATIVIDADE]), "@reg", RELATED(dCliente[REGIME]),
			    "@resp", RELATED(dCliente[RESPONSAVEL]),
			    "@alerta", VAR cod = fCarteira[CODIGO_CLIENTE] RETURN MAXX(TOPN(1, FILTER(fAlerta, fAlerta[CODIGO_CLIENTE] = cod), fAlerta[ORDEM], ASC), fAlerta[TITULO]))
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;padding:14px 18px 10px;height:498px;overflow:hidden'><div style='font-size:15px;font-weight:700'>Todos os clientes</div><div style='font-size:12px;color:#A9C6C2;margin:1px 0 10px'>Ordenados pelos que mais precisam de atenção. Faturamento e margem dos últimos 12 meses.</div><div style='display:grid;grid-template-columns:92px 1.5fr .9fr 96px 70px 62px 1.5fr 60px;gap:10px;font-size:11px;color:#7A9A96;padding-bottom:4px;border-bottom:1px solid #1F6F66'><div style='text-align:left'>Situação</div><div style='text-align:left'>Cliente</div><div style='text-align:left'>Regime</div><div style='text-align:right'>Faturamento 12 m</div><div style='text-align:right'>Margem</div><div style='text-align:right'>Liquidez</div><div style='text-align:left'>Principal alerta</div><div style='text-align:left'>Resp.</div></div>"
			    & CONCATENATEX(t, "<div style='display:grid;grid-template-columns:92px 1.5fr .9fr 96px 70px 62px 1.5fr 60px;gap:10px;align-items:center;font-size:11px;line-height:1.1;padding:1.5px 0;border-bottom:1px solid #1B4A49'><div>" & "<span style='display:inline-block;font-size:10px;font-weight:600;border-radius:99px;padding:0 7px;line-height:13px;border:1px solid " & SWITCH(fCarteira[SITUACAO], "Crítico", "#FF6B5E;color:#FF6B5E", "Atenção", "#F5C04A;color:#F5C04A", "#34E0BE;color:#34E0BE") & "'>" & SWITCH(fCarteira[SITUACAO], "Crítico", "✕ ", "Atenção", "! ", "✓ ") & fCarteira[SITUACAO] & "</span>" & "</div><div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis'><b style='font-weight:600'>" & [@nome] & "</b> <span style='color:#7A9A96'>" & [@ativ] & "</span></div><div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#A9C6C2'>" & [@reg] & "</div><div style='text-align:right'>" & "R$ " & FORMAT(fCarteira[RECEITA_BRUTA_12M], "#,##0") & "</div><div style='text-align:right;color:" & IF(fCarteira[MARGEM_LIQUIDA_12M] < 0, "#FF6B5E", "#F4FBFA") & "'>" & FORMAT(fCarteira[MARGEM_LIQUIDA_12M], "0.0%") & "</div><div style='text-align:right;color:" & IF(fCarteira[LIQUIDEZ_CORRENTE] < 1, "#FF6B5E", "#F4FBFA") & "'>" & FORMAT(fCarteira[LIQUIDEZ_CORRENTE], "0.00") & "</div><div style='white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#A9C6C2'>" & IF(ISBLANK([@alerta]), "Sem pontos de atenção", [@alerta]) & "</div><div style='color:#A9C6C2'>" & [@resp] & "</div></div>", "", SWITCH(fCarteira[SITUACAO], "Crítico", 0, "Atenção", 1, 2), ASC, fCarteira[RECEITA_BRUTA_12M], DESC)
			    & "</div>"
		lineageTag: 29b45a90-dc6c-51fb-a8f8-b87a309c37e5

	measure 'HTML Pauta' =
			VAR t = ADDCOLUMNS(FILTER(fCarteira, fCarteira[SITUACAO] = "Crítico"), "@nome", RELATED(dCliente[CLIENTE]),
			    "@tit", VAR cod = fCarteira[CODIGO_CLIENTE] RETURN MAXX(TOPN(1, FILTER(fAlerta, fAlerta[CODIGO_CLIENTE] = cod && fAlerta[GRAVIDADE] = "Crítico"), fAlerta[ORDEM], ASC), fAlerta[TITULO]),
			    "@txt", VAR cod = fCarteira[CODIGO_CLIENTE] RETURN MAXX(TOPN(1, FILTER(fAlerta, fAlerta[CODIGO_CLIENTE] = cod && fAlerta[GRAVIDADE] = "Crítico"), fAlerta[ORDEM], ASC), fAlerta[TEXTO]))
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;padding:14px 18px 10px;height:498px;overflow:hidden'><div style='font-size:15px;font-weight:700'>Pauta da semana</div><div style='font-size:12px;color:#A9C6C2;margin:1px 0 10px'>Um caso por cliente crítico, com o primeiro ponto a tratar.</div>"
			    & IF(COUNTROWS(t) = 0, "<div style='font-size:12px;color:#A9C6C2'>Nenhum cliente crítico neste recorte.</div>",
			        CONCATENATEX(TOPN(7, t, fCarteira[RECEITA_BRUTA_12M], DESC), "<div style='border:1px solid rgba(255,107,94,.3);border-left:4px solid #FF6B5E;border-radius:10px;padding:5px 10px;margin-bottom:5px;background:linear-gradient(90deg,rgba(255,107,94,.13),rgba(255,107,94,.02) 60%)'><div style='display:flex;justify-content:space-between;gap:8px;align-items:baseline'><b style='font-size:12.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & [@nome] & "</b><span style='font-size:10.5px;color:#FFC4BD;white-space:nowrap'>" & [@tit] & IF(fCarteira[ALERTAS_CRITICOS] > 1, " +" & FORMAT(fCarteira[ALERTAS_CRITICOS] - 1, "0"), "") & "</span></div><div style='font-size:10.5px;color:#A9C6C2;line-height:1.25;margin-top:1px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden'>" & [@txt] & "</div></div>", "", fCarteira[RECEITA_BRUTA_12M], DESC))
			    & "</div>"
		lineageTag: 65b6273e-91b7-5570-9274-642314cd0f20

	measure 'HTML Cartões Cliente' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR fM = FILTER(ALL(dMes), dMes[COMPETENCIA] = m)
			VAR fAnt = FILTER(ALL(dMes), dMes[COMPETENCIA] = EDATE(m, -1))
			VAR fAA = FILTER(ALL(dMes), dMes[COMPETENCIA] = EDATE(m, -12))
			VAR f3 = FILTER(ALL(dMes), dMes[COMPETENCIA] > EDATE(m, -3) && dMes[COMPETENCIA] <= m)
			VAR f12 = FILTER(ALL(dMes), dMes[COMPETENCIA] > EDATE(m, -12) && dMes[COMPETENCIA] <= m)
			VAR fat = CALCULATE([Faturamento], fM)
			VAR fatAA = CALCULATE([Faturamento], fAA)
			VAR luc = CALCULATE([Lucro líquido], fM)
			VAR luc3 = CALCULATE([Lucro líquido], f3)
			VAR mar3 = CALCULATE([Margem líquida], f3)
			VAR disp = [Disponível]
			VAR liq = [Liquidez corrente]
			VAR carga = CALCULATE([Carga tributária], fM)
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;display:flex;gap:12px'>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & "#34E0BE" & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Faturamento do mês</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & "#F4FBFA" & "'>" & "R$ " & FORMAT(fat, "#,##0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & IF(ISBLANK(fatAA), "primeiro ano de histórico", FORMAT(DIVIDE(fat, fatAA) - 1, "+0.0%;-0.0%") & " sobre um ano antes") & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & IF(luc < 0, "#FF6B5E", "#34E0BE") & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Lucro do mês</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & IF(luc < 0, "#FF6B5E", "#F4FBFA") & "'>" & "R$ " & FORMAT(luc, "#,##0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "R$ " & FORMAT(luc3, "#,##0") & " no trimestre" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & IF(mar3 < 0, "#FF6B5E", "#34E0BE") & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Sobra de cada R$ 100</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & IF(mar3 < 0, "#FF6B5E", "#F4FBFA") & "'>" & "R$ " & FORMAT(mar3 * 100, "0.0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "margem líquida do trimestre" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & "#34E0BE" & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Dinheiro disponível</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & "#F4FBFA" & "'>" & "R$ " & FORMAT(disp, "#,##0") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "caixa e aplicações" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & IF(liq < 1, "#FF6B5E", "#34E0BE") & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Para cada R$ 1 a pagar</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & IF(liq < 1, "#FF6B5E", "#F4FBFA") & "'>" & "R$ " & FORMAT(liq, "0.00") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "em caixa, a receber e estoque" & "</div></div>"
			    & "<div style='flex:1;min-width:0;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;height:112px;padding:13px 15px;position:relative;overflow:hidden'><div style='position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg," & "#34E0BE" & ",rgba(0,0,0,0))'></div><div style='font-size:12px;color:#A9C6C2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>Impostos</div><div style='font-size:27px;font-weight:700;letter-spacing:-.5px;line-height:1.25;white-space:nowrap;color:" & "#F4FBFA" & "'>" & FORMAT(carga, "0.0%") & "</div><div style='font-size:11.5px;color:#A9C6C2;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "do faturamento do mês" & "</div></div>"
			    & "</div>"
		lineageTag: a58b9380-b83d-5607-9065-f305d5c74303

	measure 'HTML Alertas Cliente' =
			VAR n = COUNTROWS(fAlerta)
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;padding:14px 18px 10px;height:244px;overflow:hidden'><div style='font-size:15px;font-weight:700'>O que conversar com o cliente</div><div style='font-size:12px;color:#A9C6C2;margin:1px 0 10px'>Os pontos que o balancete levanta, em linguagem de dono de empresa.</div>"
			    & IF(n = 0, "<div style='border-left:4px solid #34E0BE;border-radius:10px;padding:9px 12px;background:rgba(52,224,190,.1);font-size:12.5px'><b>✓ Nenhum ponto de atenção neste balancete</b></div>",
			        CONCATENATEX(TOPN(4, fAlerta, fAlerta[ORDEM], ASC, fAlerta[CODIGO_CLIENTE], ASC), "<div style='border-radius:10px;padding:7px 12px;margin-bottom:6px;border-left:4px solid " & IF(fAlerta[GRAVIDADE] = "Crítico", "#FF6B5E", "#F5C04A") & ";background:linear-gradient(90deg," & IF(fAlerta[GRAVIDADE] = "Crítico", "rgba(255,107,94,.13)", "rgba(245,192,74,.12)") & ",rgba(0,0,0,0) 65%)'><div style='font-size:12.5px;font-weight:700'><span style='font-size:11px;margin-right:8px;color:" & IF(fAlerta[GRAVIDADE] = "Crítico", "#FF6B5E", "#F5C04A") & "'>" & IF(fAlerta[GRAVIDADE] = "Crítico", "✕ Crítico", "! Atenção") & "</span>" & IF(HASONEVALUE(dCliente[CLIENTE]), "", RELATED(dCliente[CLIENTE]) & ": ") & fAlerta[TITULO] & "</div><div style='font-size:11.5px;color:#A9C6C2;line-height:1.3;margin-top:1px'>" & fAlerta[TEXTO] & "</div></div>", "", fAlerta[ORDEM], ASC, fAlerta[CODIGO_CLIENTE], ASC))
			    & "</div>"
		lineageTag: 23dcfd79-0e64-5ead-b305-0b4566f13b58

	measure 'HTML Cada 100' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR fM = FILTER(ALL(dMes), dMes[COMPETENCIA] = m)
			VAR fAnt = FILTER(ALL(dMes), dMes[COMPETENCIA] = EDATE(m, -1))
			VAR fAA = FILTER(ALL(dMes), dMes[COMPETENCIA] = EDATE(m, -12))
			VAR f3 = FILTER(ALL(dMes), dMes[COMPETENCIA] > EDATE(m, -3) && dMes[COMPETENCIA] <= m)
			VAR f12 = FILTER(ALL(dMes), dMes[COMPETENCIA] > EDATE(m, -12) && dMes[COMPETENCIA] <= m)
			VAR rb = CALCULATE([Faturamento], f3)
			VAR imp = -CALCULATE(SUM(fIndicador[DEDUCOES]) + SUM(fIndicador[IMPOSTO_LUCRO]), f3)
			VAR cus = -CALCULATE([Custo total], f3)
			VAR pes = -CALCULATE([Despesas com pessoal], f3)
			VAR adm = -CALCULATE([Despesas administrativas] + [Despesa de depreciação], f3)
			VAR jur = -CALCULATE([Resultado financeiro], f3)
			VAR luc = CALCULATE([Lucro líquido], f3)
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;padding:14px 18px 10px;height:244px;overflow:hidden'><div style='font-size:15px;font-weight:700'>Para onde vai cada R$ 100 que entram</div><div style='font-size:12px;color:#A9C6C2;margin:1px 0 10px'>Média do último trimestre.</div><div style='display:flex;gap:3px;height:34px;margin-bottom:12px'>"
			    & IF(imp > 0, "<div style='flex:" & FORMAT(INT(imp), "0") & " 0 0;min-width:3px;border-radius:7px;background:#9B8CF2;color:#FFFFFF;font-size:12px;font-weight:700;padding:8px 8px;white-space:nowrap;overflow:hidden;box-sizing:border-box'>" & IF(DIVIDE(imp, rb) > 0.07, FORMAT(DIVIDE(imp, rb) * 100, "0"), "") & "</div>", "")
			    & IF(cus > 0, "<div style='flex:" & FORMAT(INT(cus), "0") & " 0 0;min-width:3px;border-radius:7px;background:#1F6F66;color:#FFFFFF;font-size:12px;font-weight:700;padding:8px 8px;white-space:nowrap;overflow:hidden;box-sizing:border-box'>" & IF(DIVIDE(cus, rb) > 0.07, FORMAT(DIVIDE(cus, rb) * 100, "0"), "") & "</div>", "")
			    & IF(pes > 0, "<div style='flex:" & FORMAT(INT(pes), "0") & " 0 0;min-width:3px;border-radius:7px;background:#FF8A65;color:#FFFFFF;font-size:12px;font-weight:700;padding:8px 8px;white-space:nowrap;overflow:hidden;box-sizing:border-box'>" & IF(DIVIDE(pes, rb) > 0.07, FORMAT(DIVIDE(pes, rb) * 100, "0"), "") & "</div>", "")
			    & IF(adm > 0, "<div style='flex:" & FORMAT(INT(adm), "0") & " 0 0;min-width:3px;border-radius:7px;background:#F5C04A;color:#061A1C;font-size:12px;font-weight:700;padding:8px 8px;white-space:nowrap;overflow:hidden;box-sizing:border-box'>" & IF(DIVIDE(adm, rb) > 0.07, FORMAT(DIVIDE(adm, rb) * 100, "0"), "") & "</div>", "")
			    & IF(jur > 0, "<div style='flex:" & FORMAT(INT(jur), "0") & " 0 0;min-width:3px;border-radius:7px;background:#F78FB3;color:#061A1C;font-size:12px;font-weight:700;padding:8px 8px;white-space:nowrap;overflow:hidden;box-sizing:border-box'>" & IF(DIVIDE(jur, rb) > 0.07, FORMAT(DIVIDE(jur, rb) * 100, "0"), "") & "</div>", "")
			    & IF(luc > 0, "<div style='flex:" & FORMAT(INT(luc), "0") & " 0 0;min-width:3px;border-radius:7px;background:#34E0BE;color:#061A1C;font-size:12px;font-weight:700;padding:8px 8px;white-space:nowrap;overflow:hidden;box-sizing:border-box'>" & IF(DIVIDE(luc, rb) > 0.07, FORMAT(DIVIDE(luc, rb) * 100, "0"), "") & "</div>", "")
			    & "</div><div style='display:grid;grid-template-columns:1fr 1fr;gap:5px 22px;font-size:12px;color:#A9C6C2'>"
			    & IF(imp > 0, "<div style='display:flex;align-items:center;gap:7px'><i style='width:10px;height:10px;border-radius:3px;background:#9B8CF2'></i>Impostos e devoluções<b style='margin-left:auto;color:#F4FBFA'>R$ " & FORMAT(DIVIDE(imp, rb) * 100, "0.0") & "</b></div>", "")
			    & IF(cus > 0, "<div style='display:flex;align-items:center;gap:7px'><i style='width:10px;height:10px;border-radius:3px;background:#1F6F66'></i>Mercadoria e serviço<b style='margin-left:auto;color:#F4FBFA'>R$ " & FORMAT(DIVIDE(cus, rb) * 100, "0.0") & "</b></div>", "")
			    & IF(pes > 0, "<div style='display:flex;align-items:center;gap:7px'><i style='width:10px;height:10px;border-radius:3px;background:#FF8A65'></i>Pessoal<b style='margin-left:auto;color:#F4FBFA'>R$ " & FORMAT(DIVIDE(pes, rb) * 100, "0.0") & "</b></div>", "")
			    & IF(adm > 0, "<div style='display:flex;align-items:center;gap:7px'><i style='width:10px;height:10px;border-radius:3px;background:#F5C04A'></i>Despesas administrativas<b style='margin-left:auto;color:#F4FBFA'>R$ " & FORMAT(DIVIDE(adm, rb) * 100, "0.0") & "</b></div>", "")
			    & IF(jur > 0, "<div style='display:flex;align-items:center;gap:7px'><i style='width:10px;height:10px;border-radius:3px;background:#F78FB3'></i>Juros e tarifas<b style='margin-left:auto;color:#F4FBFA'>R$ " & FORMAT(DIVIDE(jur, rb) * 100, "0.0") & "</b></div>", "")
			    & IF(luc > 0, "<div style='display:flex;align-items:center;gap:7px'><i style='width:10px;height:10px;border-radius:3px;background:#34E0BE'></i>Lucro<b style='margin-left:auto;color:#F4FBFA'>R$ " & FORMAT(DIVIDE(luc, rb) * 100, "0.0") & "</b></div>", "")
			    & "</div>"
			    & IF(luc < 0, "<div style='font-size:11.5px;color:#FF6B5E;margin-top:9px'>Saíram R$ " & FORMAT(DIVIDE(rb - luc, rb) * 100, "0.0") & " para cada R$ 100 que entraram.</div>", "")
			    & "</div>"
		lineageTag: 81a0971e-d222-5bf5-a1ad-ea728fba10de

	measure 'HTML Simples' =
			VAR um = HASONEVALUE(dCliente[CODIGO_CLIENTE])
			VAR ms = MAX(fSimples[COMPETENCIA])
			VAR f = FILTER(ALL(dMes), dMes[COMPETENCIA] = ms)
			VAR rbt = CALCULATE(MAX(fSimples[RBT12]), f)
			VAR faixa = CALCULATE(MAX(fSimples[FAIXA]), f)
			VAR usoF = CALCULATE(MAX(fSimples[USO_FAIXA]), f)
			VAR usoL = CALCULATE(MAX(fSimples[USO_LIMITE_SIMPLES]), f)
			VAR folga = CALCULATE(MAX(fSimples[FOLGA_FAIXA]), f)
			VAR lim = CALCULATE(MAX(fSimples[LIMITE_SIMPLES]), f)
			VAR aliq = CALCULATE(MAX(fSimples[ALIQUOTA_EFETIVA]), f)
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;padding:14px 18px 10px;height:254px;overflow:hidden'><div style='font-size:15px;font-weight:700'>Simples Nacional</div><div style='font-size:12px;color:#A9C6C2;margin:1px 0 10px'>A faixa depende do faturamento dos últimos 12 meses.</div>"
			    & IF(NOT um, "<div style='font-size:12.5px;color:#A9C6C2'>Selecione um cliente para ver a faixa do Simples.</div>",
			        IF(ISBLANK(rbt), "<div style='font-size:12.5px;color:#A9C6C2'>Este cliente não está no Simples Nacional.</div>",
			            "<div style='display:flex;justify-content:space-between;font-size:12.5px;margin-top:7px'><span style='color:#A9C6C2'>Faturamento de 12 meses</span><b>" & "R$ " & FORMAT(rbt, "#,##0") & "</b></div>" & "<div style='display:flex;justify-content:space-between;font-size:12.5px;margin-top:7px'><span style='color:#A9C6C2'>Faixa atual</span><b>" & FORMAT(faixa, "0") & " de 6" & "</b></div>" & "<div style='display:flex;justify-content:space-between;font-size:12.5px;margin-top:7px'><span style='color:#A9C6C2'>Alíquota efetiva</span><b>" & FORMAT(aliq, "0.0%") & "</b></div>" & "<div style='font-size:12px;color:#A9C6C2;display:flex;justify-content:space-between;margin-top:9px'><span>Uso da faixa atual</span><b style='color:#F4FBFA'>" & IF(ISBLANK(folga), "acima do limite", "faltam " & "R$ " & FORMAT(folga, "#,##0")) & "</b></div><div style='height:9px;border-radius:5px;background:#061A1C;margin-top:4px;overflow:hidden'><div style='height:9px;border-radius:5px;background:linear-gradient(90deg,#1F6F66,#34E0BE);width:" & FORMAT(INT(MIN(1, usoF) * 100), "0") & "%'></div></div>" & "<div style='font-size:12px;color:#A9C6C2;display:flex;justify-content:space-between;margin-top:9px'><span>Uso do limite do Simples</span><b style='color:#F4FBFA'>" & "faltam " & "R$ " & FORMAT(lim - rbt, "#,##0") & "</b></div><div style='height:9px;border-radius:5px;background:#061A1C;margin-top:4px;overflow:hidden'><div style='height:9px;border-radius:5px;background:linear-gradient(90deg,#1F6F66,#34E0BE);width:" & FORMAT(INT(MIN(1, usoL) * 100), "0") & "%'></div></div>" & "<div style='font-size:10.5px;color:#7A9A96;margin-top:10px'>Tabela simplificada para a demonstração.</div>"))
			    & "</div>"
		lineageTag: 504757fb-d2e5-5ea8-8556-2a75f6fea373

	measure 'HTML DRE' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR fM = FILTER(ALL(dMes), dMes[COMPETENCIA] = m)
			VAR fAnt = FILTER(ALL(dMes), dMes[COMPETENCIA] = EDATE(m, -1))
			VAR fAA = FILTER(ALL(dMes), dMes[COMPETENCIA] = EDATE(m, -12))
			VAR f3 = FILTER(ALL(dMes), dMes[COMPETENCIA] > EDATE(m, -3) && dMes[COMPETENCIA] <= m)
			VAR f12 = FILTER(ALL(dMes), dMes[COMPETENCIA] > EDATE(m, -12) && dMes[COMPETENCIA] <= m)
			RETURN
			    "<div style='font-family:Segoe UI,sans-serif;color:#F4FBFA;line-height:1.35;background:linear-gradient(180deg,#123A3B,#0C2A2C);border:1px solid #1B4A49;border-radius:16px;box-sizing:border-box;padding:14px 18px 10px;height:622px;overflow:hidden'><div style='font-size:15px;font-weight:700'>Resultado do mês</div><div style='font-size:12px;color:#A9C6C2;margin:1px 0 10px'>Demonstração de resultado resumida: mês, mês anterior, um ano antes e últimos 12 meses.</div><div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:11.5px;color:#7A9A96;padding-bottom:6px;border-bottom:1px solid #1F6F66'><div>Em reais</div><div style='text-align:right'>" & FORMAT(m, "mm/yyyy") & "</div><div style='text-align:right'>" & FORMAT(EDATE(m, -1), "mm/yyyy") & "</div><div style='text-align:right'>" & FORMAT(EDATE(m, -12), "mm/yyyy") & "</div><div style='text-align:right'>12 meses</div></div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>Receita bruta</div>"
			    & (VAR x = CALCULATE([Faturamento], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Faturamento], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Faturamento], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Faturamento], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>(-) Impostos e devoluções</div>"
			    & (VAR x = CALCULATE([Impostos e devoluções], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Impostos e devoluções], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Impostos e devoluções], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Impostos e devoluções], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;font-weight:700;padding:8px 0;border-bottom:1px solid #1F6F66'><div>Receita líquida</div>"
			    & (VAR x = CALCULATE([Receita líquida], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Receita líquida], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Receita líquida], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Receita líquida], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>(-) Custo da mercadoria e do serviço</div>"
			    & (VAR x = CALCULATE([Custo total], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Custo total], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Custo total], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Custo total], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;font-weight:700;padding:8px 0;border-bottom:1px solid #1F6F66'><div>Lucro bruto</div>"
			    & (VAR x = CALCULATE([Lucro bruto], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Lucro bruto], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Lucro bruto], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Lucro bruto], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>(-) Pessoal</div>"
			    & (VAR x = CALCULATE([Despesas com pessoal], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesas com pessoal], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesas com pessoal], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesas com pessoal], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>(-) Despesas administrativas</div>"
			    & (VAR x = CALCULATE([Despesas administrativas], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesas administrativas], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesas administrativas], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesas administrativas], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>(-) Depreciação</div>"
			    & (VAR x = CALCULATE([Despesa de depreciação], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesa de depreciação], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesa de depreciação], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Despesa de depreciação], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;font-weight:700;padding:8px 0;border-bottom:1px solid #1F6F66'><div>Resultado operacional</div>"
			    & (VAR x = CALCULATE([Resultado operacional], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Resultado operacional], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Resultado operacional], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Resultado operacional], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;padding:8px 0;border-bottom:1px solid #1B4A49'><div>Resultado financeiro</div>"
			    & (VAR x = CALCULATE([Resultado financeiro], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Resultado financeiro], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Resultado financeiro], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Resultado financeiro], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
