			    & (VAR x = CALCULATE([IRPJ e CSLL], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([IRPJ e CSLL], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([IRPJ e CSLL], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([IRPJ e CSLL], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & "</div>"
			    & "<div style='display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr 1.1fr;gap:10px;font-size:12.5px;font-weight:700;padding:8px 0;border-bottom:1px solid #1F6F66'><div>Lucro líquido</div>"
			    & (VAR x = CALCULATE([Lucro líquido], fM) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Lucro líquido], fAnt) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Lucro líquido], fAA) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
			    & (VAR x = CALCULATE([Lucro líquido], f12) RETURN "<div style='text-align:right;color:" & IF(x < 0, "#FF6B5E", "#F4FBFA") & "'>" & IF(ISBLANK(x), "–", FORMAT(x, "#,##0")) & "</div>")
