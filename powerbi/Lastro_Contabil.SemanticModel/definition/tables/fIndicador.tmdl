table fIndicador
	lineageTag: f3c139e3-2d44-5639-b716-a50c70ee5fd5

	measure Faturamento = SUM(fIndicador[RECEITA_BRUTA])
		formatString: \R\$ #,##0
		lineageTag: 78955711-e656-5bba-a0a1-b4416d354176

	measure 'Impostos e devoluções' = SUM(fIndicador[DEDUCOES])
		formatString: \R\$ #,##0
		lineageTag: 81cdff6a-9465-5860-b0ea-bd8cc3ceed3b

	measure 'Receita líquida' = SUM(fIndicador[RECEITA_LIQUIDA])
		formatString: \R\$ #,##0
		lineageTag: 4a8cabf6-58fc-56da-9e56-6dca5a4ef463

	measure 'Custo total' = SUM(fIndicador[CUSTOS])
		formatString: \R\$ #,##0
		lineageTag: 2c539a2d-3042-5ff9-b50d-60eeba428085

	measure 'Lucro bruto' = SUM(fIndicador[LUCRO_BRUTO])
		formatString: \R\$ #,##0
		lineageTag: b579f8c9-2857-5bdc-9839-c9151b4fc779

	measure 'Despesas com pessoal' = SUM(fIndicador[DESPESAS_PESSOAL])
		formatString: \R\$ #,##0
		lineageTag: cd059bb8-ae85-5a4b-ac2e-43ac9b8bb8a6

	measure 'Despesas administrativas' = SUM(fIndicador[DESPESAS_ADMINISTRATIVAS])
		formatString: \R\$ #,##0
		lineageTag: d03488a1-1acd-5703-9527-e42185c7572b

	measure 'Despesa de depreciação' = SUM(fIndicador[DEPRECIACAO])
		formatString: \R\$ #,##0
		lineageTag: 5684ecb8-07c1-57fb-ba9a-a97ea9388166

	measure 'Resultado operacional' = SUM(fIndicador[RESULTADO_OPERACIONAL])
		formatString: \R\$ #,##0
		lineageTag: 537231a3-0db5-59f1-9b83-2dccc627a8da

	measure 'Resultado financeiro' = SUM(fIndicador[RESULTADO_FINANCEIRO])
		formatString: \R\$ #,##0
		lineageTag: 079bb134-7c68-5348-bb0a-42adbdfd4c0c

	measure 'IRPJ e CSLL' = SUM(fIndicador[IMPOSTO_LUCRO])
		formatString: \R\$ #,##0
		lineageTag: 0778ed47-8a73-54f3-9ef1-cc398f22a30b

	measure 'Lucro líquido' = SUM(fIndicador[LUCRO_LIQUIDO])
		formatString: \R\$ #,##0
		lineageTag: 9eeba0f0-9bfc-574a-9d44-133bc01ff9b1

	measure 'Margem líquida' = DIVIDE([Lucro líquido], [Receita líquida])
		formatString: 0.0%
		lineageTag: 224dd411-6a17-5003-a132-58fb775a42c1

	measure 'Margem bruta' = DIVIDE([Lucro bruto], [Receita líquida])
		formatString: 0.0%
		lineageTag: a4a9285f-3b48-5e34-a0c1-e9108e9040df

	measure Impostos = -(SUM(fIndicador[IMPOSTOS_RECEITA]) + SUM(fIndicador[IMPOSTO_LUCRO]))
		formatString: \R\$ #,##0
		lineageTag: 19e177a9-15ff-5cfa-bef5-69ca54666292

	measure 'Carga tributária' = DIVIDE([Impostos], [Faturamento])
		formatString: 0.0%
		lineageTag: 78741eab-76f1-5d6c-8235-d2cbfb562b35

	measure Disponível =
			VAR m = MAX(fIndicador[COMPETENCIA])
			RETURN CALCULATE(SUM(fIndicador[DISPONIVEL]), FILTER(ALL(dMes), dMes[COMPETENCIA] = m))
		formatString: \R\$ #,##0
		lineageTag: d1782689-1520-55cc-bd27-2dd9545f5736

	measure 'Dívida bancária' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			RETURN CALCULATE(SUM(fIndicador[DIVIDA_BANCARIA]), FILTER(ALL(dMes), dMes[COMPETENCIA] = m))
		formatString: \R\$ #,##0
		lineageTag: 3a27fee5-b12b-5f40-bf3e-7810e79f2205

	measure 'Liquidez corrente' =
			VAR m = MAX(fIndicador[COMPETENCIA])
			VAR f = FILTER(ALL(dMes), dMes[COMPETENCIA] = m)
			RETURN DIVIDE(CALCULATE(SUM(fIndicador[ATIVO_CIRCULANTE]), f), CALCULATE(SUM(fIndicador[PASSIVO_CIRCULANTE]), f))
		formatString: 0.00
		lineageTag: 625b06ee-937d-56ad-9ab2-4dc13ec501e3

