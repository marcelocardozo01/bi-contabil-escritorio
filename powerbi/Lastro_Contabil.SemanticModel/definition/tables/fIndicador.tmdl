	partition fIndicador = m
		mode: import
		source =
				let
				    Fonte = Parquet.Document(File.Contents(PastaExports & "indicadores_mensal.parquet")),
				    Colunas = Table.SelectColumns(Fonte, {"CODIGO_CLIENTE", "COMPETENCIA", "RECEITA_BRUTA", "DEDUCOES", "IMPOSTOS_RECEITA", "RECEITA_LIQUIDA", "CUSTOS", "LUCRO_BRUTO", "DESPESAS_PESSOAL", "DESPESAS_ADMINISTRATIVAS", "DEPRECIACAO", "RESULTADO_OPERACIONAL", "RESULTADO_FINANCEIRO", "IMPOSTO_LUCRO", "LUCRO_LIQUIDO", "DISPONIVEL", "CLIENTES_A_RECEBER", "ESTOQUES", "ATIVO_CIRCULANTE", "PASSIVO_CIRCULANTE", "DIVIDA_BANCARIA"}),
				    Tipos = Table.TransformColumnTypes(Colunas, {{"CODIGO_CLIENTE", type text}, {"COMPETENCIA", type date}, {"RECEITA_BRUTA", type number}, {"DEDUCOES", type number}, {"IMPOSTOS_RECEITA", type number}, {"RECEITA_LIQUIDA", type number}, {"CUSTOS", type number}, {"LUCRO_BRUTO", type number}, {"DESPESAS_PESSOAL", type number}, {"DESPESAS_ADMINISTRATIVAS", type number}, {"DEPRECIACAO", type number}, {"RESULTADO_OPERACIONAL", type number}, {"RESULTADO_FINANCEIRO", type number}, {"IMPOSTO_LUCRO", type number}, {"LUCRO_LIQUIDO", type number}, {"DISPONIVEL", type number}, {"CLIENTES_A_RECEBER", type number}, {"ESTOQUES", type number}, {"ATIVO_CIRCULANTE", type number}, {"PASSIVO_CIRCULANTE", type number}, {"DIVIDA_BANCARIA", type number}})
				in
				    Tipos

	annotation PBI_ResultType = Table
